{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PocketDNA job envelope",
  "definitions": {
    "ok": {
      "type": "object",
      "required": ["ok", "data"],
      "properties": {
        "ok": { "const": true },
        "data": { "type": "object" }
      }
    },
    "err": {
      "type": "object",
      "required": ["ok", "code", "message"],
      "properties": {
        "ok": { "const": false },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "progressEvent": {
      "type": "object",
      "required": ["job_id", "step", "status"],
      "properties": {
        "job_id": { "type": "string" },
        "step": { "type": "integer", "minimum": 1, "maximum": 7 },
        "title": { "type": "string" },
        "model": { "type": "string" },
        "status": { "enum": ["running", "done", "failed"] },
        "artifact": { "type": "string" }
      }
    },
    "populationShare": {
      "type": "object",
      "required": ["id", "label", "weight"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "low": { "type": "number" },
        "high": { "type": "number" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "epochComposition": {
      "type": "object",
      "required": ["epoch", "shares"],
      "properties": {
        "epoch": { "enum": ["bronze", "middle", "modern"] },
        "shares": { "type": "array", "items": { "$ref": "#/definitions/populationShare" } }
      }
    }
  }
}
