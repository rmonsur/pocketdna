{
  "expo": {
    "name": "PocketDNA",
    "slug": "pocketdna",
    "scheme": "pocketdna",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "web"
    ],
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "backgroundColor": "#0A0908",
      "resizeMode": "contain"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "PocketDNA",
      "shortName": "PocketDNA",
      "description": "Your DNA results have a story. Watch it.",
      "lang": "en",
      "themeColor": "#0A0908"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
