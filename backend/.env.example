# Copy to backend/.env and fill in. backend/.env is gitignored; NEVER commit a real key.

# Meta Model API (Tier 1 screenshot path: Muse Spark vision + agents). Get a key at dev.meta.ai.
META_API_KEY=

# Tier 2 raw-file path runs on Meta OPEN WEIGHTS only (privacy invariant, enforced in code).
# modal   -> the project's Glimmer endpoint on Modal (URL below, kept live through judging)
# baseten -> Muse Spark Open via Baseten; needs BASETEN_API_KEY
OPEN_WEIGHT_PROVIDER=modal
OPENWEIGHT_BASE_URL=
OPENWEIGHT_MODEL=
BASETEN_API_KEY=

# Reference panel for the deep-time engine. Leave unset to use the committed demo panel.
ALLOW_FIXTURE_PANEL=1
# POCKETDNA_PANEL_PATH=/path/to/aadr-panel.npz

# Safety: set to 1 to refuse every paid model call (offline demo + cache only).
KILL_PAID_CALLS=

# SQLite job store (defaults to backend/pocketdna.db).
# POCKETDNA_DB=
